DATABASE_URL="postgresql://submissions:submissions@localhost:5434/submissions?schema=public"
# URL of the problems-service (used to fetch test cases)
PROBLEMS_URL="http://localhost:3001"

# URL of the users-service (used to fetch user info and record problem status)
USERS_URL="http://localhost:3004"

# URL of the executor-service (used for code execution)
EXECUTOR_URL="http://localhost:3005"

# Must match EXECUTOR_SHARED_SECRET in executor-service
EXECUTOR_SHARED_SECRET="change-me-in-production"

# Redis connection (used by BullMQ for the async judge queue)
REDIS_URL="redis://localhost:6379"

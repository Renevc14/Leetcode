{
  "name": "users-service",
  "version": "0.0.1",
  "description": "Microservicio de perfiles y estadísticas de usuario - LeetCode Clone",
  "main": "dist/index.js",
  "scripts": {
    "build-model": "cd .. && gradlew.bat build",
    "link-ssdk": "node -e \"const fs=require('fs'); const src='../smithy/build/smithyprojections/smithy/source/typescript-ssdk-codegen'; if(fs.existsSync('ssdk')) fs.rmSync('ssdk',{recursive:true}); fs.symlinkSync(require('path').resolve(src),'ssdk','junction');\"",
    "build-ssdk": "cd ssdk && npm install && npm run build",
    "setup": "npm run build-model && npm run link-ssdk && npm run build-ssdk && npm install",
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "dev": "npx tsx watch src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "@types/node": "^20.12.13"
  },
  "dependencies": {
    "@aws-smithy/server-node": "^1.0.0-alpha.10",
    "@com.leetcode/users-server": "file:ssdk"
  }
}

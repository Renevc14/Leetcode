PORT=3005

# Prebuilt language runner images (built once via docker/build.sh)
EXEC_IMAGE_PYTHON=leetcode-exec-python:latest
EXEC_IMAGE_NODE=leetcode-exec-node:latest
EXEC_IMAGE_JAVA=leetcode-exec-java:latest
EXEC_IMAGE_CPP=leetcode-exec-cpp:latest

# Maximum containers allowed to run concurrently on this host
MAX_CONCURRENT_CONTAINERS=4

# CPU quota assigned to each container (Docker --cpus)
CONTAINER_CPU=1.0

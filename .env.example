# Database credentials for local docker compose
# Copy this file to .env and adjust values as needed.

# Problems service PostgreSQL (port 5433)
PROBLEMS_POSTGRES_DB=problems
PROBLEMS_POSTGRES_USER=problems
PROBLEMS_POSTGRES_PASSWORD=problems

# Submissions service PostgreSQL (port 5434)
SUBMISSIONS_POSTGRES_DB=submissions
SUBMISSIONS_POSTGRES_USER=submissions
SUBMISSIONS_POSTGRES_PASSWORD=submissions

# Users service PostgreSQL (port 5435)
USERS_POSTGRES_DB=users
USERS_POSTGRES_USER=users
USERS_POSTGRES_PASSWORD=users

# Contests service PostgreSQL (port 5436)
CONTESTS_POSTGRES_DB=contests
CONTESTS_POSTGRES_USER=contests
CONTESTS_POSTGRES_PASSWORD=contests

# Redis (port 6379) — usado por contests-service (leaderboard) y caches
# No requiere credenciales en local

# URL del issuer OIDC de Authentik (incluye barra final)
VITE_AUTH_AUTHORITY=http://localhost:9000/application/o/leetcode/

# Client ID configurado en la aplicación OIDC de Authentik
VITE_AUTH_CLIENT_ID=leetcode

# URL de retorno tras el login (debe coincidir con la registrada en Authentik)
VITE_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Base URL del API Gateway (output ApiUrl del stack)
VITE_API_BASE_URL=https://abc123.execute-api.us-east-1.amazonaws.com

{
  "name": "leetcode",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de autenticación y autorización para una plataforma tipo LeetCode (OIDC + RBAC).",
  "scripts": {
    "prepare": "husky",
    "lint:infra": "npm --prefix infra run lint",
    "format:infra": "npm --prefix infra run format:check"
  },
  "lint-staged": {
    "infra/**/*.{ts,mjs,cjs,js}": [
      "prettier --write --config infra/.prettierrc.json"
    ],
    "infra/**/*.{json,md,yml,yaml}": [
      "prettier --write --config infra/.prettierrc.json"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3"
  }
}

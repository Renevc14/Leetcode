{
  "name": "leetcode",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de autenticación y autorización para una plataforma tipo LeetCode (OIDC + RBAC).",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r run build"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write --config frontend/.prettierrc.json"
    ],
    "frontend/**/*.{json,md,css,html}": [
      "prettier --write --config frontend/.prettierrc.json"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3"
  }
}

{
  "name": "leetcode",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de autenticación y autorización para una plataforma tipo LeetCode (OIDC + RBAC).",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "smithy:build": "pnpm --filter @leetcode/smithy run smithy:build",
    "smithy:build:sdk": "pnpm --filter '@com.leetcode/*' run build",
    "build": "pnpm -r run build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "lint-staged": {
    "microservices/**/*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "frontend/**/*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write --config frontend/.prettierrc.json"
    ],
    "frontend/**/*.{json,md,css,html}": [
      "prettier --write --config frontend/.prettierrc.json"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
